<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>L'Ardoise du Jour - Menu</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">

		<style>
			/* --- RESET ET BASE --- */
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				/* Fond mural flouté pour mettre en valeur l'ardoise */
				background: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
				background-size: cover;
				font-family: 'Kalam', cursive;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				padding: 20px;
				color: #fff;
			}

			/* --- LE CADRE EN BOIS --- */
			.wood-frame {
				background: #5d4037; /* Couleur de base bois */
				/* Simulation de texture bois via CSS gradients */
				background-image: repeating-linear-gradient(45deg, rgba(0,0,0,0.1) 0px, rgba(0,0,0,0.1) 2px, transparent 2px, transparent 4px), linear-gradient(to right, #4e342e, #8d6e63, #4e342e);
				padding: 20px;
				border-radius: 15px;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), /* Ombre portée au sol */
				inset 0 0 10px rgba(0, 0, 0, 0.5); /* Profondeur intérieure */
				max-width: 600px;
				width: 100%;
				position: relative;
			}

			/* --- LA SURFACE ARDOISE --- */
			.slate-surface {
				background-color: #2b2b2b;
				/* Texture granuleuse subtile */
				background-image: radial-gradient(circle at center, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.1) 100%), url("data:image/svg+xml, %3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.1'/%3E%3C/svg%3E");
				border: 2px solid #3e3e3e;
				padding: 30px;
				border-radius: 4px;
				text-align: center;
				position: relative;
			}

			/* Effet de craie globale */
			.chalk-text {
				color: #f0f0f0;
				text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.3); /* Léger flou pour l'effet poudre */
			}

			/* --- HEADER --- */
			header {
				margin-bottom: 30px;
				border-bottom: 2px solid rgba(255, 255, 255, 0.3);
				padding-bottom: 15px;
				/* Trait "dessiné à la main" */
				border-radius: 50% 50% 5% 5% / 5px;
			}

			h1 {
				font-family: 'Amatic SC', cursive;
				font-size: 3.5rem;
				font-weight: 700;
				letter-spacing: 2px;
				margin-bottom: 5px;
				color: #ffffff;
			}

			.date {
				font-size: 1.4rem;
				color: #ffcc80; /* Une touche de couleur craie orange */
				transform: rotate(-2deg); /* Légère rotation pour le côté manuscrit */
				display: inline-block;
			}

			/* --- MENU ITEMS --- */
			.menu-section {
				margin-bottom: 25px;
			}

			.category-title {
				font-family: 'Amatic SC', cursive;
				font-size: 2rem;
				color: #81d4fa; /* Craie bleue claire */
				text-transform: uppercase;
				text-decoration: underline wavy rgba(129, 212, 250, 0.5); /* Soulignement vague */
				margin-bottom: 10px;
			}

			.dish-name {
				font-size: 1.6rem;
				font-weight: 700;
				margin-bottom: 5px;
				line-height: 1.3;
			}

			/* Séparateur décoratif */
			.separator {
				font-size: 1.5rem;
				color: rgba(255, 255, 255, 0.2);
				margin: 15px 0;
			}

			/* --- PRICING SECTION --- */
			.pricing-container {
				margin-top: 40px;
				border: 2px dashed rgba(255, 255, 255, 0.4);
				padding: 20px;
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.03);
				transform: rotate(1deg); /* Côté organique */
			}

			.pricing-title {
				font-family: 'Amatic SC', cursive;
				font-size: 2.2rem;
				margin-bottom: 15px;
				color: #ffab91; /* Craie corail */
			}

			.price-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 15px;
				text-align: left;
			}

			.price-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 1px dotted rgba(255, 255, 255, 0.2);
				padding-bottom: 5px;
			}

			.price-label {
				font-size: 1.3rem;
			}

			.price-value {
				font-family: 'Amatic SC', cursive;
				font-size: 2rem;
				font-weight: bold;
				color: #a5d6a7; /* Craie verte */
			}

			/* --- FOOTER / LOGO --- */
			.footer-note {
				margin-top: 25px;
				font-size: 0.9rem;
				opacity: 0.6;
			}

			/* --- RESPONSIVE --- */
			@media(min-width: 600px) {
				.price-grid {
					grid-template-columns: 1fr 1fr; /* 2 colonnes pour les prix sur desktop */
					gap: 30px;
				}
				.price-item:last-child {
					grid-column: span 2;
					justify-content: center;
					border-bottom: none;
					background: rgba(255, 255, 255, 0.05);
					padding: 10px;
					border-radius: 5px;
				}
				.price-item:last-child .price-label {
					margin-right: 20px;
					font-weight: bold;
					text-transform: uppercase;
				}
			}
		</style>
	</head>
	<body>

		<div class="wood-frame">
			<div class="slate-surface chalk-text">

				<header>
					<h1>{{ restaurant.name }}</h1>
					<span class="date" id="date-du-jour">{{ ardoise.titre }}</span>
				</header>

				<main>
					<div class="menu-section">
						{% if ardoise.dailyEntree %}
							<div class="category-title">Pour commencer</div>
							<div class="dish-name">{{ ardoise.dailyEntree|nl2br }}</div>
						{% endif %}
					</div>

					<div class="separator">~ ✻ ~</div>

					<div class="menu-section">
						{% if ardoise.dailyPlat %}
							<div class="category-title">Le Plat du Jour</div>
							<div class="dish-name">{{ ardoise.dailyPlat|nl2br }}</div>
						{% endif %}
					</div>

					<div class="separator">~ ✻ ~</div>

					<div class="menu-section">
						{% if ardoise.dailyDessert %}
							<div class="category-title">La Douceur</div>
							<div class="dish-name">{{ ardoise.dailyDessert|nl2br }}</div>
						{% endif %}
					</div>
				</main>

				<footer class="pricing-container">
					<div class="pricing-title">Nos Formules Midi</div>
					<div class="price-grid">
						{% if ardoise.priceEpd or ardoise.pricePj or ardoise.pricePd %}
							<div class="price-item">
								<span class="price-label">Plat du Jour</span>
								{% if ardoise.pricePj %}
									<span class="price-value">{{ ardoise.pricePj|number_format(2, ',', ' ') }}€</span>
								{% endif %}
							</div>

							<div class="price-item">
								<span class="price-label">Entrée + Plat ou Plat + Dessert</span>
								{% if ardoise.pricePd %}
									<span class="price-value">{{ ardoise.pricePd|number_format(2, ',', ' ') }}€</span>
								{% endif %}
							</div>

							<div class="price-item">
								<span class="price-label">La Totale (E + P + D)</span>
								{% if ardoise.priceEpd %}
									<span class="price-value">{{ ardoise.priceEpd|number_format(2, ',', ' ') }}€</span>
								{% endif %}
							</div>
						{% endif %}
					</div>
				</footer>

				<p class="footer-note">Fait maison avec amour & produits frais</p>

			</div>
		</div>

		<script>
			// Script pour afficher la date du jour automatiquement
document.addEventListener('DOMContentLoaded', function () {
const dateElement = document.getElementById('date-du-jour');
const options = {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric'
};
const today = new Date();

// Met la première lettre en majuscule
const dateString = today.toLocaleDateString('fr-FR', options);
const formattedDate = dateString.charAt(0).toUpperCase() + dateString.slice(1);

dateElement.textContent = formattedDate;
});
		</script>

	</body>
</html>
