{% extends 'public/menus-du-jour/_base_daily.html.twig' %}

{% block menu_head %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="{{ asset('styles/public/templates/timeline.css') }}">
{% endblock %}

{% block menu_content %}
<!-- Header / Fiche Restaurant -->
<header class="restaurant-header">
    <div class="header-content">
        <div class="header-icon">
            <i class="fas fa-concierge-bell"></i>
        </div>
        <h1 class="header-title">{{ restaurant.name }}</h1>
        <p class="header-subtitle">{{ ardoise.titre }}</p>
        <div class="header-divider"></div>
        <p class="header-description">
            Une expérience culinaire unique où chaque plat raconte une histoire
        </p>
    </div>
</header>

<!-- Timeline Container -->
<main class="timeline-container">

    <!-- Timeline Line (ligne centrale) -->
    <div class="timeline-line"></div>

    <!-- ÉTAPE 1 : Entrée -->
    <div class="timeline-item" data-step="1">
        <div class="timeline-dot">
            <i class="fas fa-leaf"></i>
        </div>
        <div class="timeline-content timeline-left">
            <div class="timeline-card">
                <div class="card-badge">
                    <span class="badge-number">01</span>
                    <span class="badge-label">Entrée</span>
                </div>
                <div class="card-main">
                    {% if ardoise.dailyEntree %}
                        <h3 class="card-title">{{ ardoise.dailyEntree|nl2br }}</h3>
                    {% else %}
                        <h3 class="card-title">Notre entrée du jour</h3>
                    {% endif %}
                </div>
                <div class="card-decoration">
                    <i class="fas fa-utensils"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ÉTAPE 2 : Plat Principal -->
    <div class="timeline-item" data-step="2">
        <div class="timeline-dot">
            <i class="fas fa-drumstick-bite"></i>
        </div>
        <div class="timeline-content timeline-right">
            <div class="timeline-card">
                <div class="card-badge">
                    <span class="badge-number">02</span>
                    <span class="badge-label">Plat Principal</span>
                </div>
                <div class="card-main">
                    {% if ardoise.dailyPlat %}
                        <h3 class="card-title">{{ ardoise.dailyPlat|nl2br }}</h3>
                    {% else %}
                        <h3 class="card-title">Notre plat du jour</h3>
                    {% endif %}
                </div>
                <div class="card-decoration">
                    <i class="fas fa-fire"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ÉTAPE 3 : Dessert -->
    <div class="timeline-item" data-step="3">
        <div class="timeline-dot">
            <i class="fas fa-ice-cream"></i>
        </div>
        <div class="timeline-content timeline-left">
            <div class="timeline-card">
                <div class="card-badge">
                    <span class="badge-number">03</span>
                    <span class="badge-label">Dessert</span>
                </div>
                <div class="card-main">
                    {% if ardoise.dailyDessert %}
                        <h3 class="card-title">{{ ardoise.dailyDessert|nl2br }}</h3>
                    {% else %}
                        <h3 class="card-title">Notre dessert du jour</h3>
                    {% endif %}
                </div>
                <div class="card-decoration">
                    <i class="fas fa-candy-cane"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Point final de la timeline -->
    <div class="timeline-end">
        <div class="timeline-dot-end">
            <i class="fas fa-check"></i>
        </div>
    </div>

</main>

<!-- Section Tarifs -->
<section class="pricing-section">
    <div class="pricing-container">
        <h2 class="pricing-title">Nos Formules</h2>
        <p class="pricing-subtitle">Choisissez la formule qui vous convient</p>

        <div class="pricing-grid">
            {% if ardoise.pricePj %}
            <div class="pricing-card">
                <div class="pricing-header">
                    <div class="pricing-icon">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h3 class="pricing-name">Plat Seul</h3>
                </div>
                <div class="pricing-price">
                    <span class="price-value">{{ ardoise.pricePj }}</span>
                    <span class="price-currency">€</span>
                </div>
                <div class="pricing-description">
                    Le plat principal uniquement
                </div>
            </div>
            {% endif %}

            {% if ardoise.pricePd %}
            <div class="pricing-card pricing-featured">
                <div class="pricing-ribbon">Recommandé</div>
                <div class="pricing-header">
                    <div class="pricing-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h3 class="pricing-name">Formule 2 Plats</h3>
                </div>
                <div class="pricing-price">
                    <span class="price-value">{{ ardoise.pricePd }}</span>
                    <span class="price-currency">€</span>
                </div>
                <div class="pricing-description">
                    Entrée + Plat<br>ou Plat + Dessert
                </div>
            </div>
            {% endif %}

            {% if ardoise.priceEpd %}
            <div class="pricing-card">
                <div class="pricing-header">
                    <div class="pricing-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <h3 class="pricing-name">Formule Complète</h3>
                </div>
                <div class="pricing-price">
                    <span class="price-value">{{ ardoise.priceEpd }}</span>
                    <span class="price-currency">€</span>
                </div>
                <div class="pricing-description">
                    Entrée + Plat + Dessert
                </div>
            </div>
            {% endif %}
        </div>

        <div class="pricing-note">
            <i class="fas fa-info-circle"></i>
            <p>Tous nos plats sont préparés avec des produits frais et de saison sélectionnés avec soin</p>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="footer">
    <p>&copy; 2025 {{ restaurant.name }} - Tous droits réservés</p>
    <p class="footer-tagline">L'excellence au service de votre palais</p>
</footer>
{% endblock %}

{% block menu_scripts %}
<script>
// Animation au scroll - Timeline Items
const observerOptions = {
    threshold: 0.3,
    rootMargin: '0px 0px -100px 0px'
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('visible');
        }
    });
}, observerOptions);

// Observer tous les items de la timeline
document.querySelectorAll('.timeline-item').forEach(item => {
    observer.observe(item);
});

// Animation de la ligne de progression
window.addEventListener('scroll', () => {
    const timelineContainer = document.querySelector('.timeline-container');
    const timelineLine = document.querySelector('.timeline-line');

    if (timelineContainer && timelineLine) {
        const containerRect = timelineContainer.getBoundingClientRect();
        const containerHeight = timelineContainer.offsetHeight;
        const windowHeight = window.innerHeight;

        const scrollProgress = Math.max(0, Math.min(1,
            (windowHeight - containerRect.top) / (containerHeight + windowHeight)
        ));

        timelineLine.style.setProperty('--scroll-progress', scrollProgress);
    }
});

// Animation initiale au chargement
window.addEventListener('load', () => {
    document.querySelector('.restaurant-header').classList.add('loaded');
});
</script>
{% endblock %}
