<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ carte.name }} - {{ restaurant.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,400&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #1a1a1a;    /* Noir Encre */
            --accent-color: #c5a059;     /* Or Bistrot */
            --bg-color: #fdfcf8;         /* Papier Crème */
            --text-muted: #6b7280;
            --border-color: #e5e7eb;
            --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-color);
            color: var(--primary-color);
            line-height: 1.6;
            padding-bottom: 50px;
        }

        /* --- Header Chic --- */
        .hero-header {
            background-color: var(--primary-color);
            color: white;
            padding: 80px 20px;
            text-align: center;
            margin-bottom: 60px;
            position: relative;
            border-bottom: 5px solid var(--accent-color);
        }

        .restaurant-badge {
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 0.9em;
            color: var(--accent-color);
            margin-bottom: 10px;
            display: block;
        }

        .carte-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            margin-bottom: 20px;
            font-weight: 800;
        }

        .header-meta {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            max-width: 800px;
            margin: 0 auto;
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .header-meta span {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* --- Layout de la Carte --- */
        .menu-container {
            max-width: 1600px; /* Full width optimisé */
            margin: 0 auto;
            padding: 0 40px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            gap: 40px;
        }

        /* --- Section de la Carte --- */
        .carte-section {
            margin-bottom: 40px;
        }

        .section-header {
            border-bottom: 2px solid var(--primary-color);
            margin-bottom: 30px;
            padding-bottom: 10px;
            display: flex;
            align-items: baseline;
            justify-content: space-between;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 600;
            position: relative;
        }

        .section-description {
            font-style: italic;
            color: var(--text-muted);
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        /* --- Articles (Plats) --- */
        .menu-item {
            margin-bottom: 35px;
            position: relative;
            transition: transform 0.3s ease;
        }

        .item-main {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 15px;
        }

        .dish-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 600;
            flex-grow: 0;
        }

        /* Ligne pointillée décorative entre le nom et le prix */
        .spacer-dots {
            flex-grow: 1;
            border-bottom: 1px dotted var(--border-color);
            margin-bottom: 5px;
        }

        .item-price {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            color: var(--accent-color);
            font-size: 1.1rem;
        }

        .dish-description {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 8px 0;
            max-width: 85%;
            line-height: 1.4;
        }

        /* --- Badges et Tags --- */
        .item-footer {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 3px 10px;
            background: #eee;
            border-radius: 2px;
            font-weight: 600;
        }

        .variant-badge {
            font-size: 0.65rem;
            background: var(--accent-color);
            color: white;
            padding: 2px 6px;
            border-radius: 2px;
            text-transform: uppercase;
        }

        .tva-info {
            font-size: 0.7rem;
            color: #ccc;
        }

        /* --- Responsive Design --- */
        @media (max-width: 1024px) {
            .menu-container {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .menu-container {
                grid-template-columns: 1fr;
                padding: 0 20px;
            }

            .hero-header {
                padding: 50px 15px;
            }

            .header-meta {
                flex-direction: column;
                gap: 10px;
            }

            .spacer-dots {
                display: none; /* Plus propre sur petit écran */
            }
        }

        /* Print optimization */
        /* Preview Mode Banner */
        .preview-banner {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            color: #78350f;
            padding: 12px 20px;
            text-align: center;
            font-weight: 600;
            border-bottom: 3px solid #d97706;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .preview-banner-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .preview-icon {
            font-size: 1.2em;
        }

        @media print {
            .preview-banner { display: none !important; }
            .hero-header { background: white !important; color: black !important; border-bottom: 2px solid black; }
            .item-price { color: black !important; }
            .menu-container { display: block; }
            .carte-section { page-break-inside: avoid; }
        }
    </style>
</head>
<body>

    {% if previewMode is defined and previewMode %}
    <div class="preview-banner">
        <div class="preview-banner-content">
            <span class="preview-icon">👁️</span>
            <span>Mode Prévisualisation - Cette carte n'est pas encore publiée</span>
        </div>
    </div>
    {% endif %}

    <header class="hero-header">
        <span class="restaurant-badge">{{ restaurant.name }}</span>
        <h1 class="carte-title">{{ carte.name }}</h1>

        <div class="header-meta">
            <span>📍 {{ restaurant.address }}, {{ restaurant.zipCode }} {{ restaurant.city }}</span>
            {% if restaurant.phoneNumber %}
                <span>📞 {{ restaurant.phoneNumber }}</span>
            {% endif %}
            <span>🗓
                {% if carte.validTo %}
                    Du {{ carte.validFrom|date('d/m/Y') }} au {{ carte.validTo|date('d/m/Y') }}
                {% else %}
                    Saison {{ "now"|date("Y") }}
                {% endif %}
            </span>
        </div>
    </header>

    <main class="menu-container">
        {% for section in carte.sections %}

        <section class="carte-section">
            <div class="section-header">
                <h2 class="section-title">{{ section.titre }}</h2>
            </div>

            {% if section.description %}
                <p class="section-description">{{ section.description }}</p>
            {% endif %}

            <div class="section-content">
                {% for item in section.items %}
                <article class="menu-item">
                    <div class="item-main">
                        <span class="dish-name">
                            {{ item.platVariant.platCatalogue.name }}
                            <small style="font-weight: 400; font-size: 0.8rem; font-style: italic; color: var(--accent-color);">
                                ({{ item.platVariant.label }})
                            </small>
                        </span>
                        <div class="spacer-dots"></div>
                        <span class="item-price">{{ (item.platVariant.priceCents / 100)|number_format(2, ',', ' ') }} €</span>
                    </div>

                    {% if item.platVariant.platCatalogue.description %}
                        <p class="dish-description">{{ item.platVariant.platCatalogue.description }}</p>
                    {% endif %}

                    <div class="item-footer">
                        {% if item.platVariant.isDefault %}
                            <span class="variant-badge">Signature</span>
                        {% endif %}

                        {# {% if item.platVariant.platCatalogue.tags|length > 0 %}
                            {% for tag in item.platVariant.platCatalogue.tags %}
                                <span class="tag">{{ tag.label }}</span>
                            {% endfor %}
                        {% endif %} #}

                        <span class="tva-info">TVA {{ item.platVariant.tvaRate }}%</span>
                    </div>
                </article>
                {% endfor %}
            </div>
        </section>
        {% endfor %}
    </main>

    <script>
        // Optionnel : Ajout d'une animation simple au scroll pour un effet "Premium"
        const observerOptions = { threshold: 0.1 };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = "1";
                    entry.target.style.transform = "translateY(0)";
                }
            });
        }, observerOptions);

        document.querySelectorAll('.carte-section').forEach(section => {
            section.style.opacity = "0";
            section.style.transform = "translateY(20px)";
            section.style.transition = "all 0.6s ease-out";
            observer.observe(section);
        });
    </script>
</body>
</html>
