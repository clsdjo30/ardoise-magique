<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {# Homepage #}
    <url>
        <loc>{{ url('app_landing') }}</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>

    {# Tarifs page #}
    <url>
        <loc>{{ url('app_tarifs') }}</loc>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>

    {# Blog index #}
    <url>
        <loc>{{ url('app_blog_index') }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>

    {# Blog posts #}
    {% for post in posts %}
    <url>
        <loc>{{ url('app_blog_show', {category: post.category, slug: post.slug}) }}</loc>
        <lastmod>{{ post.publishedAt|date('Y-m-d') }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {% endfor %}

    {# Directory index #}
    <url>
        <loc>{{ url('app_directory_index') }}</loc>
        <changefreq>daily</changefreq>
        <priority>0.9</priority>
    </url>

    {# Directory by city #}
    {% for city in cities %}
    <url>
        <loc>{{ url('app_directory_city', {citySlug: city|lower|replace({' ': '-'})}) }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    {% endfor %}

    {# Directory by region #}
    {% for dept in departements %}
    <url>
        <loc>{{ url('app_directory_region', {departementSlug: dept|lower|replace({' ': '-'})}) }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    {% endfor %}

    {# Restaurant pages #}
    {% for restaurant in restaurants %}
    {% if restaurant.slug %}
    <url>
        <loc>{{ url('app_directory_restaurant_show', {slug: restaurant.slug}) }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    {% endif %}
    {% endfor %}
</urlset>
