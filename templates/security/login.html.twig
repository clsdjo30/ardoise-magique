{% extends 'base.html.twig' %}

{% block title %}Connexion - L'Ardoise Magique
{% endblock %}

{% block body %}
	<div class="login-container">
		<div class="login-card">
			<div class="login-header login-header__row-title" >
				<div>
					<i class="fas fa-utensils"></i>
					<h1>Connexion</h1>
				</div>
				<p>Accedez a votre tableau de bord</p>
			</div>

			<div class="login-body">
				{% if error %}
					<div class="alert alert-danger">
						<i class="fas fa-exclamation-circle"></i>
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</div>
				{% endif %}

				{% if app.user %}
					<div class="alert alert-info ">
						<i class="fas fa-info-circle"></i>
						Vous etes connecte en tant que
						<strong>{{ app.user.userIdentifier }}</strong>
						<br>
						<a href="{{ path('app_logout') }}" class="text-decoration-underline">Se deconnecter</a>
					</div>
				{% endif %}

				<form method="post">
					<div class="form-group">
						<label for="username">Email</label>
						<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" placeholder="exemple@restaurant.fr" autocomplete="email" required autofocus>
					</div>

					<div class="form-group">
						<label for="password">Mot de passe</label>
						<input type="password" name="_password" id="password" class="form-control" placeholder="Votre mot de passe" autocomplete="current-password" required>
					</div>

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<button class="btn btn-login" type="submit">
						<i class="fas fa-sign-in-alt"></i>
						Se connecter
					</button>
				</form>
			</div>

			<div class="register-link">
				<p class="">
					Pas encore de compte ?
					<a href="{{ path('app_register') }}">
						<i class="fas fa-user-plus"></i>
						Creer un compte
					</a>
				</p>
			</div>
		</div>
	</div>
{% endblock %}
