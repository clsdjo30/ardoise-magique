{% extends 'base.html.twig' %}

{% block meta_title %}{{ post.metaTitle }}{% endblock %}
{% block meta_description %}{{ post.metaDescription }}{% endblock %}

{% block meta_extra %}
    {# Open Graph meta tags #}
    <meta property="og:title" content="{{ post.metaTitle }}">
    <meta property="og:description" content="{{ post.metaDescription }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ url('app_blog_show', {category: post.category, slug: post.slug}) }}">
    <meta property="article:published_time" content="{{ post.publishedAt|date('c') }}">
    {% if post.hasImage %}
    <meta property="og:image" content="{{ absolute_url(asset(post.image)) }}">
    {% endif %}

    {# SEO Keywords #}
    {% if post.seoKeywords|length > 0 %}
    <meta name="keywords" content="{{ post.seoKeywords|join(', ') }}">
    {% endif %}

    {# JSON-LD Structured Data #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{{ post.title|e('js') }}",
        "description": "{{ post.excerpt|e('js') }}",
        "datePublished": "{{ post.publishedAt|date('c') }}",
        "author": {
            "@type": "Organization",
            "name": "L'Ardoise Magique",
            "url": "{{ url('app_landing') }}"
        },
        "publisher": {
            "@type": "Organization",
            "name": "L'Ardoise Magique",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ absolute_url('/images/ardoise_magik_icone.webp') }}"
            }
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ url('app_blog_show', {category: post.category, slug: post.slug}) }}"
        }
    }
    </script>
{% endblock %}

{% block body %}
{# Hero section with article info #}
<section class="article-hero">
    <div class="l-container">
        {# Breadcrumb #}
        <nav class="article-breadcrumb">
            <a href="{{ path('app_landing') }}" class="article-breadcrumb__link">
                <i class="fas fa-home"></i> Accueil
            </a>
            <span class="article-breadcrumb__separator">/</span>
            <a href="{{ path('app_blog_index') }}" class="article-breadcrumb__link">Blog</a>
            <span class="article-breadcrumb__separator">/</span>
            <span class="article-breadcrumb__current">{{ post.category|capitalize }}</span>
        </nav>

        {# Article header #}
        <header class="article-header">
            <div class="article-header__meta">
                <span class="article-category article-category--{{ post.category }}">
                    {{ post.category|capitalize }}
                </span>
                <span class="article-date">
                    <i class="far fa-calendar"></i>
                    {{ post.publishedAt|date('d F Y') }}
                </span>
            </div>
            <h1 class="article-title">{{ post.title }}</h1>
            <p class="article-excerpt">{{ post.excerpt }}</p>
        </header>
    </div>
</section>

{# Article content section #}
<article class="article-content-section">
    <div class="l-container">
        <div class="article-container">
            {# Featured image #}
            {% if post.hasImage %}
                <div class="article-image-wrapper">
                    <img src="{{ asset(post.image) }}"
                         alt="{{ post.title }}"
                         class="article-image">
                </div>
            {% endif %}

            {# Article content #}
            <div class="article-content">
                {{ post.htmlContent|raw }}
            </div>

            {# Article footer #}
            <footer class="article-footer">
                {% if post.seoKeywords|length > 0 %}
                <div class="article-tags">
                    <div class="article-tags__label">
                        <i class="fas fa-tags"></i>
                        Mots-clés:
                    </div>
                    <div class="article-tags__list">
                        {% for keyword in post.seoKeywords %}
                            <span class="article-tag">{{ keyword }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <div class="article-actions">
                    <a href="{{ path('app_blog_index') }}" class="article-back-button">
                        <i class="fas fa-arrow-left"></i>
                        Retour au blog
                    </a>
                </div>
            </footer>
        </div>
    </div>
</article>

{# Styles #}
<style>
/* MOBILE FIRST APPROACH */

/* Article Hero Section */
.article-hero {
    background: linear-gradient(135deg, #e8dfd6 0%, #d4c4b7 100%);
    padding: 2rem 0 1.5rem;
    position: relative;
}

.article-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 60%);
    pointer-events: none;
}

.article-hero .l-container {
    position: relative;
    z-index: 1;
    max-width: 900px;
}

/* Breadcrumb */
.article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
}

.article-breadcrumb__link {
    color: #6b4b36;
    text-decoration: none;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.article-breadcrumb__link:hover {
    color: #b85c38;
}

.article-breadcrumb__separator {
    color: #9b8b6e;
}

.article-breadcrumb__current {
    color: #2f1b0c;
    font-weight: 600;
}

/* Article Header */
.article-header {
    text-align: center;
}

.article-header__meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    flex-direction: column;
}

.article-category {
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: capitalize;
    color: white;
}

.article-category--recettes {
    background: #b85c38;
}

.article-category--sorties {
    background: #4a7a4a;
}

.article-category--conseils {
    background: #6c7c90;
}

.article-category--actualites {
    background: #b2853f;
}

.article-date {
    color: #6b4b36;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
}

.article-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #2f1b0c;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.article-excerpt {
    font-size: 1rem;
    color: #6b4b36;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
}

/* Article Content Section */
.article-content-section {
    padding: 1.5rem 0 2rem;
    background: #f8f3ef;
}

.article-content-section .l-container {
    max-width: 900px;
}

.article-container {
    background: #fffaf6;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(47, 27, 12, 0.08);
    overflow: hidden;
    border: 1px solid #d4c4b7;
}

/* Featured Image */
.article-image-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
}

.article-image {
    width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: cover;
    display: block;
}

/* Article Content */
.article-content {
    padding: 1.5rem 1rem;
    line-height: 1.7;
    font-size: 1rem;
    color: #2f1b0c;
}

.article-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #b85c38;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e8dfd6;
}

.article-content h2:first-child {
    margin-top: 0;
}

.article-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #6b4b36;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
}

.article-content h4 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #6b4b36;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
}

.article-content p {
    margin-bottom: 1rem;
    color: #2f1b0c;
}

.article-content ul,
.article-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
}

.article-content li {
    margin-bottom: 0.5rem;
    color: #2f1b0c;
}

.article-content li::marker {
    color: #b85c38;
}

.article-content a {
    color: #b85c38;
    text-decoration: underline;
    transition: color 0.3s ease;
}

.article-content a:hover {
    color: #9d4e30;
}

.article-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
    box-shadow: 0 2px 12px rgba(47, 27, 12, 0.08);
}

.article-content blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: #f8f3ef;
    border-left: 3px solid #b85c38;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #6b4b36;
    font-size: 0.9375rem;
}

.article-content code {
    background: #e8dfd6;
    color: #2f1b0c;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.875em;
}

.article-content pre {
    background: #2f1b0c;
    color: #f8f3ef;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    box-shadow: 0 2px 8px rgba(47, 27, 12, 0.12);
}

.article-content pre code {
    background: none;
    color: #f8f3ef;
    padding: 0;
}

.article-content strong {
    font-weight: 600;
    color: #2f1b0c;
}

.article-content em {
    font-style: italic;
}

.article-content hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, #d4c4b7, transparent);
    margin: 2rem 0;
}

/* Article Footer */
.article-footer {
    padding: 1.5rem 1rem;
    background: linear-gradient(135deg, #f8f3ef 0%, #e8dfd6 100%);
    border-top: 1px solid #d4c4b7;
}

.article-tags {
    margin-bottom: 1.5rem;
}

.article-tags__label {
    color: #6b4b36;
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
}

.article-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.article-tag {
    display: inline-block;
    padding: 0.4rem 0.875rem;
    background: #fffaf6;
    color: #b85c38;
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid #d4c4b7;
    transition: all 0.3s ease;
}

.article-tag:hover {
    background: #b85c38;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(184, 92, 56, 0.2);
}

.article-actions {
    display: flex;
    justify-content: center;
}

.article-back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.5rem;
    background: #b85c38;
    color: white;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(184, 92, 56, 0.2);
    font-size: 0.9375rem;
}

.article-back-button:hover {
    background: #9d4e30;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(184, 92, 56, 0.3);
}

/* Tablet & Desktop (≥768px) */
@media (min-width: 768px) {
    .article-hero {
        padding: 3.5rem 0 2.5rem;
    }

    .article-breadcrumb {
        gap: 0.75rem;
        margin-bottom: 2rem;
        font-size: 0.875rem;
    }

    .article-breadcrumb__link {
        gap: 0.5rem;
    }

    .article-header__meta {
        flex-direction: row;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .article-category {
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
    }

    .article-date {
        gap: 0.5rem;
        font-size: 0.9375rem;
    }

    .article-title {
        font-size: 2.25rem;
        margin-bottom: 1.5rem;
    }

    .article-excerpt {
        font-size: 1.125rem;
        line-height: 1.6;
    }

    .article-content-section {
        padding: 2.5rem 0 3rem;
    }

    .article-container {
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(47, 27, 12, 0.1);
    }

    .article-image {
        max-height: 450px;
    }

    .article-content {
        padding: 2.5rem 2rem;
        line-height: 1.8;
        font-size: 1.0625rem;
    }

    .article-content h2 {
        font-size: 1.875rem;
        margin-top: 2.5rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
    }

    .article-content h3 {
        font-size: 1.5rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }

    .article-content h4 {
        font-size: 1.25rem;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
    }

    .article-content p {
        margin-bottom: 1.25rem;
    }

    .article-content ul,
    .article-content ol {
        margin-bottom: 1.25rem;
        padding-left: 2rem;
    }

    .article-content li {
        margin-bottom: 0.625rem;
    }

    .article-content img {
        border-radius: 12px;
        margin: 2rem 0;
        box-shadow: 0 4px 16px rgba(47, 27, 12, 0.1);
    }

    .article-content blockquote {
        margin: 1.75rem 0;
        padding: 1.25rem 1.75rem;
        border-left: 4px solid #b85c38;
        font-size: 1rem;
    }

    .article-content pre {
        padding: 1.25rem;
        margin: 1.75rem 0;
    }

    .article-content hr {
        height: 2px;
        margin: 2.5rem 0;
    }

    .article-footer {
        padding: 2rem 2rem;
    }

    .article-tags {
        margin-bottom: 2rem;
    }

    .article-tags__label {
        margin-bottom: 1rem;
        gap: 0.5rem;
        font-size: 1rem;
    }

    .article-tags__list {
        gap: 0.75rem;
    }

    .article-tag {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
    }

    .article-back-button {
        gap: 0.75rem;
        padding: 0.875rem 2rem;
        font-size: 1rem;
    }
}

/* Desktop Large (≥1024px) */
@media (min-width: 1024px) {
    .article-hero {
        padding: 4.5rem 0 3rem;
    }

    .article-title {
        font-size: 2.75rem;
    }

    .article-excerpt {
        font-size: 1.25rem;
    }

    .article-content-section {
        padding: 3rem 0 4rem;
    }

    .article-image {
        max-height: 500px;
    }

    .article-content {
        padding: 3rem;
        font-size: 1.125rem;
    }

    .article-content h2 {
        font-size: 2.25rem;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
    }

    .article-content h3 {
        font-size: 1.75rem;
        margin-top: 2.5rem;
    }

    .article-content h4 {
        font-size: 1.375rem;
        margin-top: 2rem;
    }

    .article-content p {
        margin-bottom: 1.5rem;
    }

    .article-content ul,
    .article-content ol {
        margin-bottom: 1.5rem;
    }

    .article-content li {
        margin-bottom: 0.75rem;
    }

    .article-content img {
        margin: 2.5rem 0;
    }

    .article-content blockquote {
        margin: 2rem 0;
        padding: 1.5rem 2rem;
    }

    .article-content pre {
        padding: 1.5rem;
        margin: 2rem 0;
    }

    .article-content hr {
        margin: 3rem 0;
    }

    .article-footer {
        padding: 2.5rem 3rem;
    }
}
</style>
{% endblock %}
