<!-- SECTION 1 — HERO -->
<section id="hero" class="hero">
  <div class="hero__container">
    {# Left side - Content #}
    <div class="hero__content">
      {# Tagline with diamonds #}
      <div class="hero__tagline">
        <p class="hero__tagline-text">Refresh Your Taste Buds</p>
        <div class="hero__diamonds">
          <span class="hero__diamond"></span>
          <span class="hero__diamond"></span>
          <span class="hero__diamond"></span>
        </div>
      </div>

      {# Main title #}
      <h1 class="hero__title">
        Delicious Foods With<br>
        Wonderful <span class="hero__title-highlight">Eating</span>
      </h1>

      {# Description #}
      <p class="hero__description">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>

      {# Call to action buttons #}
      <div class="hero__cta-wrapper">
        <a href="#menu" class="hero__cta hero__cta--primary">
          Menu
        </a>
        <a href="#reservation" class="hero__cta hero__cta--secondary">
          Book a table
        </a>
      </div>
    </div>

    {# Right side - Visual with circular image and decorative rings #}
    <div class="hero__visual">
      <div class="hero__image-wrapper">
        {# Decorative rings #}
        <div class="hero__ring hero__ring--outer"></div>

        {# Main image circle #}
        <div class="hero__image-circle">
          <img
            src="{{ asset('images/landing/hero-ardoise.webp') }}"
            alt="Delicious healthy food plate with salmon and vegetables"
            width="550"
            height="550"
            loading="eager"
          >
        </div>

        <div class="hero__ring hero__ring--inner"></div>
      </div>
    </div>
  </div>

  {# Background decorative elements #}
  <svg class="hero__deco hero__deco--1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <path fill="currentColor" d="M100 20 L120 60 L160 60 L130 90 L145 130 L100 105 L55 130 L70 90 L40 60 L80 60 Z"/>
  </svg>

  <svg class="hero__deco hero__deco--2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <path fill="currentColor" d="M100 20 L120 60 L160 60 L130 90 L145 130 L100 105 L55 130 L70 90 L40 60 L80 60 Z"/>
  </svg>
</section>
