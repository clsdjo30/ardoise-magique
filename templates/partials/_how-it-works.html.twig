<!-- SECTION 3 — CRÉEZ VOS MENUS EN QUELQUES MINUTES -->
<section id="section-creation-menus" class="section section--creation">
  <div class="section__container section__container--split">
    <div class="section__content">
      <header class="section__header">
        <h2 class="section__title">
          Créez vos menus en quelques minutes, sans compétence technique
        </h2>
      </header>

      <p class="section__text">
        Avec Ardoise Magique, tout est pensé pour aller vite.
        Remplissez vos plats, choisissez un design adapté à votre établissement
        et publiez votre menu du jour en ligne en quelques clics.
      </p>

      <p class="section__text">
        L’interface est intuitive et accessible depuis une tablette,
        un ordinateur ou un smartphone.
      </p>

      <div class="creation__steps">
        <h3 class="creation__title">
          Comment ça marche&nbsp;?
        </h3>

        <ol class="creation__list">
          <li class="creation__item">
            <span class="creation__step-number">1</span>
            <div class="creation__step-content">
              <h4 class="creation__step-title">Saisissez vos plats</h4>
              <p class="creation__step-text">
                Entrées, plats, desserts, boissons&nbsp;: composez votre menu du jour ou votre menu spécial.
              </p>
            </div>
          </li>

          <li class="creation__item">
            <span class="creation__step-number">2</span>
            <div class="creation__step-content">
              <h4 class="creation__step-title">Choisissez le design</h4>
              <p class="creation__step-text">
                Moderne, traditionnel ou festif&nbsp;: sélectionnez une présentation adaptée à votre restaurant.
              </p>
            </div>
          </li>

          <li class="creation__item">
            <span class="creation__step-number">3</span>
            <div class="creation__step-content">
              <h4 class="creation__step-title">Publiez et partagez</h4>
              <p class="creation__step-text">
                Générez un lien ou un QR Code et partagez votre menu sur Facebook, Instagram
                ou directement en salle.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <div class="section__cta-wrapper">
        <a href="#section-tarifs" class="btn btn--primary">
          Tester gratuitement Ardoise Magique
        </a>
      </div>
    </div>

    <!-- Optionnel : illustration ou mockup à droite -->
    <div class="section__visual creation__visual">
      <!-- Exemple : illustration “3 étapes” -->
      <!-- <img src="/assets/images/creation-steps.jpg"
           alt="Les 3 étapes pour créer un menu du jour avec Ardoise Magique"
           class="section__image"> -->
    </div>
  </div>
</section>
