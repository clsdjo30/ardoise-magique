{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Nos Plans d'Abonnement{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Choisissez votre plan</h1>
        <p class="lead text-muted">Des solutions adaptées à tous vos besoins</p>
    </div>

    <div class="row g-4 justify-content-center">
        {% for code, plan in plans %}
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 {% if code == currentPlanCode %}border-primary border-3{% endif %}">
                {% if code == currentPlanCode %}
                <div class="card-header bg-primary text-white text-center py-2">
                    <small class="fw-bold">VOTRE PLAN ACTUEL</small>
                </div>
                {% endif %}

                <div class="card-body d-flex flex-column">
                    <div class="text-center mb-4">
                        <h3 class="card-title fw-bold mb-3">{{ plan.name }}</h3>
                        <div class="display-4 fw-bold mb-2">
                            {% if plan.price == 0 %}
                                Gratuit
                            {% else %}
                                {{ plan.price }}€
                            {% endif %}
                        </div>
                        {% if plan.price > 0 %}
                        <p class="text-muted">
                            par {{ plan.interval == 'month' ? 'mois' : 'an' }}
                        </p>
                        {% endif %}
                    </div>

                    <ul class="list-unstyled mb-4 flex-grow-1">
                        {# Menus du Jour #}
                        {% if plan.features.menus_daily.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            {% if plan.features.menus_daily.quota == -1 %}
                                <strong>Menus du jour illimités</strong>
                            {% else %}
                                <strong>{{ plan.features.menus_daily.quota }} menus du jour</strong> / mois
                            {% endif %}
                        </li>
                        {% else %}
                        <li class="mb-2">
                            <i class="fas fa-times text-danger me-2"></i>
                            <span class="text-muted">Menus du jour</span>
                        </li>
                        {% endif %}

                        {# Menus Spéciaux #}
                        {% if plan.features.menus_special.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            {% if plan.features.menus_special.quota == -1 %}
                                <strong>Menus spéciaux illimités</strong>
                            {% else %}
                                <strong>{{ plan.features.menus_special.quota }} menus spéciaux</strong> / an
                            {% endif %}
                        </li>
                        {% else %}
                        <li class="mb-2">
                            <i class="fas fa-times text-danger me-2"></i>
                            <span class="text-muted">Menus spéciaux</span>
                        </li>
                        {% endif %}

                        {# Templates #}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            <strong>{{ plan.allowed_templates|length }} template(s)</strong> de design
                        </li>

                        {# Directory #}
                        {% if plan.features.directory.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Listing dans l'annuaire
                        </li>
                        {% else %}
                        <li class="mb-2">
                            <i class="fas fa-times text-danger me-2"></i>
                            <span class="text-muted">Annuaire</span>
                        </li>
                        {% endif %}

                        {# Custom Designs #}
                        {% if plan.features.custom_designs.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Personnalisation des designs
                        </li>
                        {% endif %}

                        {# Premium Designs #}
                        {% if plan.features.premium_designs.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Designs premium exclusifs
                        </li>
                        {% endif %}

                        {# QR Code #}
                        {% if plan.features.qr_code.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Génération de QR Codes
                        </li>
                        {% endif %}

                        {# Social Share #}
                        {% if plan.features.social_share.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Partage sur les réseaux sociaux
                        </li>
                        {% endif %}

                        {# Priority Support #}
                        {% if plan.features.priority_support.enabled %}
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Support prioritaire
                        </li>
                        {% endif %}
                    </ul>

                    <div class="text-center mt-auto">
                        {% if code == currentPlanCode %}
                            <button class="btn btn-outline-primary w-100" disabled>
                                Plan actuel
                            </button>
                        {% else %}
                            <button class="btn btn-primary w-100" disabled>
                                Prochainement disponible
                            </button>
                            <small class="text-muted d-block mt-2">
                                Paiement en ligne bientôt disponible
                            </small>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="text-center mt-5">
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Retour au dashboard
        </a>
    </div>
</div>
{% endblock %}
