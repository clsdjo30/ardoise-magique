<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block meta_title %}
				{% block title %}L'Ardoise Magique
				{% endblock %}
			{% endblock %}
		</title>
		<meta name="description" content="{% block meta_description %}Gérez facilement vos menus de restaurant avec L'Ardoise Magique{% endblock %}"> {% block meta_extra %}{% endblock %}

		<!-- Font Awesome -->
		<link
		rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
		<!-- Google Fonts -->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@400;500;600&display=swap">
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">
		<link rel="preload" as="image" href="{{ asset('images/landing/hero-menu-du-jour-640.webp') }}" imagesrcset="
			            {{ asset('images/landing/hero-menu-du-jour-540.webp') }} 540w,
			            {{ asset('images/landing/hero-menu-du-jour-640.webp') }} 640w,
			            {{ asset('images/landing/hero-menu-du-jour-760.webp') }} 760w
			        " imagesizes="(min-width: 1200px) 380px, (min-width: 768px) 320px, 90vw">
		{% block stylesheets %}
			{% block extra_styles %}{% endblock %}
		{% endblock %}
	</head>
	<body>
		{% set nav_links = [
        { label: 'Accueil', href: path('app_landing'), active: app.request.attributes.get('_route') == 'app_landing' },
        { label: 'Blog', href: path('app_blog_index'), active: app.request.attributes.get('_route') starts with 'app_blog' },
        { label: 'Menu', href: '#menu' },
        {label: 'Tarifs', href: path('app_tarifs'),active: app.request.attributes.get('_route') == 'app_tarifs' },
        { label: 'Réserver', href: '#booking' }
    ] %}

		{% if app.user %}
			{% set nav_actions = [
            {
                label: 'Dashboard',
                href: is_granted('ROLE_SUPER_ADMIN') ? path('app_admin_dashboard') : path('admin', {'restaurant': app.user.slug}),
                variant: 'ghost'
            },
            {
                label: 'Déconnexion',
                href: path('app_logout'),
                variant: 'outline'
            }
        ] %}
		{% else %}
			{% set nav_actions = [
            { label: 'Connexion', href: path('app_login'), variant: 'ghost' },
            { label: 'Inscription', href: path('app_register'), variant: 'primary' }
        ] %}
		{% endif %}

		{% include 'components/_navbar.html.twig' with {
        brand_label: "L'Ardoise Magique",
        brand_href: path('app_landing'),
        links: nav_links,
        actions: nav_actions
    } %}

		<main>
			{% block body %}{% endblock %}
		</main>

		<footer class="c-footer">
			{% block footer %}{% endblock %}
			<div class="l-container">
				{# Social Media Links #}
				<div class="c-footer__social">
					<a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="c-footer__social-link">
						<i class="fab fa-instagram"></i>
					</a>
					<a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="c-footer__social-link">
						<i class="fab fa-facebook-f"></i>
					</a>
					<a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="c-footer__social-link">
						<i class="fab fa-twitter"></i>
					</a>
					<a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="c-footer__social-link">
						<i class="fab fa-linkedin-in"></i>
					</a>
				</div>

				{# Navigation Links #}
				<nav class="c-footer__nav">
					<ul class="c-footer__nav-list">
						<li class="c-footer__nav-item">
							<a href="{{ path('app_landing') }}" class="c-footer__nav-link">Accueil</a>
						</li>
						<li class="c-footer__nav-item">
							<a href="{{ path('app_blog_index') }}" class="c-footer__nav-link">Blog</a>
						</li>
						<li class="c-footer__nav-item">
							<a href="{{ path('app_tarifs') }}" class="c-footer__nav-link">Tarifs</a>
						</li>
						<li class="c-footer__nav-item">
							<a href="#" class="c-footer__nav-link">À propos</a>
						</li>
						<li class="c-footer__nav-item">
							<a href="#" class="c-footer__nav-link">Mentions légales</a>
						</li>
						<li class="c-footer__nav-item">
							<a href="#" class="c-footer__nav-link">Confidentialité</a>
						</li>
					</ul>
				</nav>

				{# Copyright #}
				<p class="c-footer__copyright">
					&copy; {{ "now"|date("Y") }} L'Ardoise Magique - Tous droits réservés
				</p>
			</div>
		</footer>

		{% block javascripts %}
			{# Entry name is "app" as defined in importmap.php #}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</body>
</html>
