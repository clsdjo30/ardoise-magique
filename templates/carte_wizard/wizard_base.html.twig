<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Créer une Carte{% endblock %} - Ardoise Magique</title>

    {# EasyAdmin CSS for consistent styling #}

    {# AssetMapper #}
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="wizard-page">
    <div class="wizard-overlay"></div>

    <div class="wizard-container">
        <div class="wizard-header">
            <button type="button" class="close-wizard" onclick="if(confirm('Êtes-vous sûr de vouloir quitter ? Vos modifications seront perdues.')) window.location.href='{{ path('app_carte_wizard_cancel') }}'">
                ✕
            </button>
            <h1>{% block wizard_title %}Créer une Carte Restaurant{% endblock %}</h1>
            <p>{% block wizard_description %}Créez votre carte en quelques étapes simples{% endblock %}</p>
        </div>

        <div class="wizard-progress">
            <div class="steps-indicator">
                <div class="step-item {% if currentStep == 'step1' %}active{% elseif currentStep in ['step2', 'step3', 'step4'] %}completed{% endif %}">
                    <div class="step-circle">1</div>
                    <span class="step-label">Informations</span>
                </div>
                <div class="step-item {% if currentStep == 'step2' %}active{% elseif currentStep in ['step3', 'step4'] %}completed{% endif %}">
                    <div class="step-circle">2</div>
                    <span class="step-label">Sections</span>
                </div>
                <div class="step-item {% if currentStep == 'step3' %}active{% elseif currentStep == 'step4' %}completed{% endif %}">
                    <div class="step-circle">3</div>
                    <span class="step-label">Plats</span>
                </div>
                <div class="step-item {% if currentStep == 'step4' %}active{% endif %}">
                    <div class="step-circle">4</div>
                    <span class="step-label">Aperçu</span>
                </div>
            </div>
        </div>

        <div class="wizard-body">
            {% block wizard_content %}{% endblock %}
        </div>
    </div>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>
