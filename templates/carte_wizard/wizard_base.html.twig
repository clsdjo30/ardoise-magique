<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Créer une Carte{% endblock %} - Ardoise Magique</title>

    {# EasyAdmin CSS for consistent styling #}

    {# AssetMapper #}
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}

</head>
<body class="wizard-page" data-controller="confirmation-modal" data-confirmation-modal-cancel-url-value="{{ path('app_carte_wizard_cancel') }}">
    <div class="wizard-overlay"></div>

    {# Modal de confirmation personnalisée #}
    <div class="confirmation-modal-backdrop" data-confirmation-modal-target="backdrop" data-action="click->confirmation-modal#closeOnBackdrop"></div>
    <div class="confirmation-modal" data-confirmation-modal-target="modal">
        <div class="confirmation-modal-content">
            <div class="confirmation-modal-header">
                <h3>Confirmer la fermeture</h3>
            </div>
            <div class="confirmation-modal-body">
                <p>Êtes-vous sûr de vouloir quitter ?</p>
                <p class="confirmation-warning">Vos modifications seront perdues.</p>
            </div>
            <div class="confirmation-modal-footer">
                <button type="button" class="btn btn-secondary" data-action="click->confirmation-modal#hide">
                    Annuler
                </button>
                <button type="button" class="btn btn-danger" data-action="click->confirmation-modal#confirm">
                    Quitter sans enregistrer
                </button>
            </div>
        </div>
    </div>

    <div class="wizard-container">
        <div class="wizard-header">
            {% if wizardData.carteId is defined and wizardData.carteId is not null %}
                {# Mode édition - Bouton retour au dashboard #}
                <button class="btn-back-dashboard">
                <a href="{{ path('admin', {restaurant: app.user.slug}) }}" class="">
                    ← Revenir au dashboard
                </a>
                </button>
            {% else %}
                {# Mode création - Bouton croix #}
                <button type="button" class="close-wizard" data-action="click->confirmation-modal#show">
                    ✕
                </button>
            {% endif %}
            <h1>{% block wizard_title %}{% if wizardData.carteId is defined and wizardData.carteId is not null %}Modifiez votre carte{% else %}Créer une Carte Restaurant{% endif %}{% endblock %}</h1>
            <p>{% block wizard_description %}{% if wizardData.carteId is defined and wizardData.carteId is not null %}Modifiez les éléments de votre carte{% else %}Créez votre carte en quelques étapes simples{% endif %}{% endblock %}</p>
        </div>

        <div class="wizard-progress">
            <div class="steps-indicator">
                <div class="step-item {% if currentStep == 'step1' %}active{% elseif currentStep in ['step2', 'step3', 'step4'] %}completed{% endif %}">
                    <div class="step-circle">1</div>
                    <span class="step-label">Informations</span>
                </div>
                <div class="step-item {% if currentStep == 'step2' %}active{% elseif currentStep in ['step3', 'step4'] %}completed{% endif %}">
                    <div class="step-circle">2</div>
                    <span class="step-label">Sections</span>
                </div>
                <div class="step-item {% if currentStep == 'step3' %}active{% elseif currentStep == 'step4' %}completed{% endif %}">
                    <div class="step-circle">3</div>
                    <span class="step-label">Plats</span>
                </div>
                <div class="step-item {% if currentStep == 'step4' %}active{% endif %}">
                    <div class="step-circle">4</div>
                    <span class="step-label">Aperçu</span>
                </div>
            </div>
        </div>

        <div class="wizard-body">
            {% block wizard_content %}{% endblock %}
        </div>
    </div>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>
