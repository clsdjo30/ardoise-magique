<div class="preview-summary">
    <div class="summary-stats">
        <div class="stat-item">
            <span class="stat-label">Restaurant</span>
            <span class="stat-value">{{ previewData.restaurant.name }}</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Valide du</span>
            <span class="stat-value">{{ previewData.validFrom|date('d/m/Y') }}</span>
        </div>
        {% if previewData.validTo %}
        <div class="stat-item">
            <span class="stat-label">Valide au</span>
            <span class="stat-value">{{ previewData.validTo|date('d/m/Y') }}</span>
        </div>
        {% endif %}
        <div class="stat-item">
            <span class="stat-label">Sections</span>
            <span class="stat-value">{{ previewData.totalSections }}</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Plats</span>
            <span class="stat-value">{{ previewData.totalDishes }}</span>
        </div>
    </div>
</div>

<div class="preview-content">
    <h3>Aperçu de la carte</h3>

    {% if previewData.sectionsWithDishes is empty %}
        <div class="preview-empty">
            <p>Aucune section n'a été créée pour cette carte.</p>
        </div>
    {% else %}
        {% for sectionData in previewData.sectionsWithDishes %}
            <div class="preview-section">
                <div class="preview-section-header">
                    <h4>{{ sectionData.section.categorie.titre }}</h4>
                    <span class="preview-section-count">{{ sectionData.count }} plat(s)</span>
                </div>

                {% if sectionData.section.description %}
                    <p class="preview-section-description">{{ sectionData.section.description }}</p>
                {% endif %}

                {% if sectionData.variants is empty %}
                    <p class="preview-section-empty">Aucun plat dans cette section</p>
                {% else %}
                    <div class="preview-dishes">
                        {% for variant in sectionData.variants %}
                            <div class="preview-dish">
                                <div class="preview-dish-info">
                                    <span class="preview-dish-name">{{ variant.platCatalogue.name }}</span>
                                    <span class="preview-dish-variant">{{ variant.label }}</span>
                                </div>
                                <span class="preview-dish-price">{{ (variant.priceCents / 100)|number_format(2, ',', ' ') }}€</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
</div>

<form method="post" class="preview-form">
    <div class="form-field">
        <label class="checkbox-label">
            <input type="checkbox" name="isPublished" value="1" {{ wizardData.isPublished ? 'checked' : '' }}>
            <span>Publier immédiatement cette carte</span>
        </label>
        <p class="form-help">Si coché, la carte sera visible publiquement</p>
    </div>

    <div class="wizard-navigation">
        <a href="{{ path('app_carte_wizard', {'step': 'step3'}) }}" class="btn btn-secondary">
            Retour
        </a>
        <button type="submit" class="btn btn-success">
            ✓ Créer la carte
        </button>
    </div>
</form>

