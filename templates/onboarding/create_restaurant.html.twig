{% extends 'base.html.twig' %}

{% block title %}Créer votre restaurant - L'Ardoise Magique{% endblock %}

{% block body %}
<div class="min-h-screen  from-slate-50 to-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-slate-900 mb-2">
                Bienvenue {{ user.firstname }} ! 👋
            </h1>
            <p class="text-lg text-slate-600">
                Pour commencer, créons votre restaurant
            </p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Formulaire #}
        <div class="bg-white shadow-xl rounded-2xl p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

            <div class="space-y-6">
                {# Nom du restaurant #}
                <div>
                    <label for="{{ form.name.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                        {{ form.name.vars.label }}
                        <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                {# Adresse #}
                <div>
                    <label for="{{ form.address.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                        {{ form.address.vars.label }}
                        <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.address, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                    {{ form_errors(form.address) }}
                </div>

                {# Code postal et Ville #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="{{ form.zipCode.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                            {{ form.zipCode.vars.label }}
                            <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.zipCode, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                        {{ form_errors(form.zipCode) }}
                    </div>

                    <div>
                        <label for="{{ form.city.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                            {{ form.city.vars.label }}
                            <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.city, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                        {{ form_errors(form.city) }}
                    </div>
                </div>

                {# Département #}
                <div>
                    <label for="{{ form.departement.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                        {{ form.departement.vars.label }}
                    </label>
                    {{ form_widget(form.departement, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                    {{ form_errors(form.departement) }}
                </div>

                {# Téléphone #}
                <div>
                    <label for="{{ form.phoneNumber.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                        {{ form.phoneNumber.vars.label }}
                    </label>
                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                    {{ form_errors(form.phoneNumber) }}
                </div>

                {# Facebook #}
                <div>
                    <label for="{{ form.facebookPage.vars.id }}" class="block text-sm font-semibold text-slate-700 mb-2">
                        {{ form.facebookPage.vars.label }}
                    </label>
                    {{ form_widget(form.facebookPage, {'attr': {'class': 'w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition'}}) }}
                    {{ form_errors(form.facebookPage) }}
                </div>
            </div>

            {# Bouton de soumission #}
            <div class="pt-6">
                <button type="submit" class="w-full from-blue-600 to-blue-700 text-white font-semibold py-4 px-6 rounded-lg hover:from-blue-700 hover:to-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-lg hover:shadow-xl">
                    Créer mon restaurant et accéder au dashboard
                </button>
            </div>

            {{ form_end(form) }}
        </div>

        {# Footer info #}
        <div class="mt-8 text-center text-sm text-slate-600">
            <p>Vous pourrez modifier ces informations plus tard depuis votre dashboard</p>
        </div>
    </div>
</div>
{% endblock %}
