{% extends 'base.html.twig' %}

{% block title %}Créer votre restaurant - L'Ardoise Magique{% endblock %}

{% block body %}
<div class="onboarding-container">
    <div class="onboarding-content">
        {# Header #}
        <div class="onboarding-header">
            <h1>
                Bienvenue {{ user.firstname }} ! 👋
            </h1>
            <p>
                Pour commencer, créons votre restaurant
            </p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-message flash-message--{{ label }}">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Formulaire #}
        <div class="onboarding-card">
            {{ form_start(form, {'attr': {'class': 'onboarding-form'}}) }}

            {# Nom du restaurant #}
            <div class="form-field">
                <label for="{{ form.name.vars.id }}">
                    {{ form.name.vars.label }}
                    <span class="required">*</span>
                </label>
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            {# Adresse #}
            <div class="form-field">
                <label for="{{ form.address.vars.id }}">
                    {{ form.address.vars.label }}
                    <span class="required">*</span>
                </label>
                {{ form_widget(form.address) }}
                {{ form_errors(form.address) }}
            </div>

            {# Code postal et Ville #}
            <div class="form-row">
                <div class="form-field">
                    <label for="{{ form.zipCode.vars.id }}">
                        {{ form.zipCode.vars.label }}
                        <span class="required">*</span>
                    </label>
                    {{ form_widget(form.zipCode) }}
                    {{ form_errors(form.zipCode) }}
                </div>

                <div class="form-field">
                    <label for="{{ form.city.vars.id }}">
                        {{ form.city.vars.label }}
                        <span class="required">*</span>
                    </label>
                    {{ form_widget(form.city) }}
                    {{ form_errors(form.city) }}
                </div>
            </div>

            {# Département #}
            <div class="form-field">
                <label for="{{ form.departement.vars.id }}">
                    {{ form.departement.vars.label }}
                </label>
                {{ form_widget(form.departement) }}
                {{ form_errors(form.departement) }}
            </div>

            {# Téléphone #}
            <div class="form-field">
                <label for="{{ form.phoneNumber.vars.id }}">
                    {{ form.phoneNumber.vars.label }}
                </label>
                {{ form_widget(form.phoneNumber) }}
                {{ form_errors(form.phoneNumber) }}
            </div>

            {# Facebook #}
            <div class="form-field">
                <label for="{{ form.facebookPage.vars.id }}">
                    {{ form.facebookPage.vars.label }}
                </label>
                {{ form_widget(form.facebookPage) }}
                {{ form_errors(form.facebookPage) }}
            </div>

            {# Bouton de soumission #}
            <div class="form-submit">
                <button type="submit">
                    Créer mon restaurant et accéder au dashboard
                </button>
            </div>

            {{ form_end(form) }}
        </div>

        {# Footer info #}
        <div class="onboarding-footer">
            <p>Vous pourrez modifier ces informations plus tard depuis votre dashboard</p>
        </div>
    </div>
</div>
{% endblock %}
