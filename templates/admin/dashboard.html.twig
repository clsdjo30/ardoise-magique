{% extends '@EasyAdmin/page/content.html.twig' %}

{% block configured_head_contents %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
	<script src="{{ asset('js/restaurant-modal.js') }}" defer></script>
{% endblock %}

{% block main %}
	{% set publishedMenu = publishedMenu ?? null %}
	{% if publishedMenu %}
		{% set publishedUrl = url('app_show_menu', {
            restaurant: publishedMenu.owner.slug,
            slug: publishedMenu.slug
        }) %}
	{% endif %}

	<div class="am-dashboard py-4">

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            {# Super Admin Dashboard - Keep existing admin view #}
            {{ include('partials/admin/_admin_dashboard.html.twig') }}

        {% elseif is_granted('ROLE_ADMIN') %}
			{# ========================================
			   RESTAURANT OWNER DASHBOARD
			   ======================================== #}

			{# SECTION 1: Welcome Header #}
			{{ include('admin/partials/header-welcome.html.twig', {
				userName: app.user.firstname,
				planCode: planCode,
				planName: planName
			}) }}

			{# SECTION 2: Statistics Cards #}
			<section class="am-section">
				<div class="row g-3 stats-grid">
					{# Total Menus Card #}
					<div class="col-6 col-lg-3">
						{{ include('admin/partials/stat-card.html.twig', {
							label: 'Total Menus',
							value: totalMenus,
							trend: 12,
						}) }}
					</div>

					{# Published Menus Card #}
					<div class="col-6 col-lg-3">
						{{ include('admin/partials/stat-card.html.twig', {
							label: 'Menus Publiés',
							value: menusPublies,
							trend: 8
						}) }}
					</div>

					{# Publication Rate Card #}
					<div class="col-6 col-lg-3">
						{% set pubRate = totalMenus > 0 ? ((menusPublies / totalMenus * 100)|round) : 0 %}
						{{ include('admin/partials/stat-card.html.twig', {
							label: 'Taux Publication',
							value: pubRate ~ '%'
						}) }}
					</div>

					{# Restaurants Card #}
					<div class="col-6 col-lg-3">
						{{ include('admin/partials/stat-card.html.twig', {
							label: 'Restaurants',
							value: userRestaurants|length
						}) }}
					</div>
				</div>
			</section>

			{# SECTION 4: Quick Actions #}
			<section class="am-section">
				<h2 class="am-section-title">
					<span class="am-section-icon">⚡</span>
					Actions Rapides
				</h2>

				<div class="row g-3">
					{# Create Daily Menu #}
					<div class="col-12 col-md-4">
						{{ include('admin/partials/action-card.html.twig', {
							icon: '🍽️',
							title: 'Créer un Menu du Jour',
							description: 'Ajoutez le menu du jour de votre restaurant',
							url: ea_url().setController('App\\Controller\\Admin\\DailyMenuCrudController').setAction('new'),
							isLocked: not canCreateDaily|default(false),
							lockMessage: 'Quota atteint'
						}) }}
					</div>

					{# Create Special Menu #}
					<div class="col-12 col-md-4">
						{{ include('admin/partials/action-card.html.twig', {
							icon: '🎉',
							title: 'Créer un Menu Spécial',
							description: 'Créez un menu pour une occasion spéciale',
							url: ea_url().setController('App\\Controller\\Admin\\SpecialMenuCrudController').setAction('new'),
							isLocked: not canCreateSpecial|default(false),
							lockMessage: '🔒 Fonctionnalité verrouillée'
						}) }}
					</div>

					{# Create Restaurant Card #}
					<div class="col-12 col-md-4">
						{{ include('admin/partials/action-card.html.twig', {
							icon: '📖',
							title: 'Créer une Carte Restaurant',
							description: 'Créez une carte complète avec sections',
							url: path('app_carte_wizard'),
							isLocked: not canCreateCarte|default(false),
							lockMessage: '🔒 Fonctionnalité verrouillée'
						}) }}
					</div>
				</div>
			</section>

			{# SECTION 5: Recent Contents #}
			{% if menus is not empty %}
				<section class="am-section">
					{# Prepare recent contents data #}
					{% set recentContents = [] %}
					{% for menu in menus|slice(0, 5) %}
						{% set recentContents = recentContents|merge([{
							type: menu.type,
							name: menu.titre,
							restaurant: menu.restaurant.name,
							date: menu.createdAt|date('d déc. Y'),
							status: menu.status
						}]) %}
					{% endfor %}

					{{ include('admin/partials/recent-contents-table.html.twig', {
						contents: recentContents
					}) }}
				</section>
			{% endif %}

            {# SECTION 3: Quota Tracking #}
			<section class="am-section">
				<h2 class="am-section-title">
					<span class="am-section-icon">📊</span>
					Suivi des Quotas
				</h2>

				<div class="row g-3">
					{# Daily Menus Quota #}
					<div class="col-12 col-md-4">
						{% if quotaInfo.daily_menus is defined %}
							{% set dailyQuota = quotaInfo.daily_menus %}
							{{ include('admin/partials/quota-card.html.twig', {
								icon: '🍽️',
								title: 'Menus du Jour',
								isLocked: not canCreateDaily|default(false),
								isUnlimited: dailyQuota.limit == -1,
								used: dailyQuota.used,
								limit: dailyQuota.limit,
								period: dailyQuota.period,
								upgradeUrl: path('app_subscription_plans'),
								color: 'green'
							}) }}
						{% endif %}
					</div>

					{# Special Menus Quota #}
					<div class="col-12 col-md-4">
						{% if quotaInfo.special_menus is defined %}
							{% set specialQuota = quotaInfo.special_menus %}
							{{ include('admin/partials/quota-card.html.twig', {
								icon: '🎉',
								title: 'Menus Spéciaux',
								isLocked: not canCreateSpecial|default(false),
								isUnlimited: specialQuota.limit == -1,
								used: specialQuota.used,
								limit: specialQuota.limit,
								period: specialQuota.period,
								upgradeUrl: path('app_subscription_plans'),
								color: 'blue'
							}) }}
						{% endif %}
					</div>

					{# Cards Quota #}
					<div class="col-12 col-md-4">
						{% if quotaInfo.cards is defined %}
							{% set cardsQuota = quotaInfo.cards %}
							{{ include('admin/partials/quota-card.html.twig', {
								icon: '📖',
								title: 'Cartes Restaurant',
								isLocked: not canCreateCarte|default(false),
								isUnlimited: cardsQuota.limit == -1,
								used: cardsQuota.used,
								limit: cardsQuota.limit,
								period: cardsQuota.period,
								upgradeUrl: path('app_subscription_plans'),
								color: 'yellow'
							}) }}
						{% endif %}
					</div>
				</div>
			</section>

			{# SECTION 6: Upgrade CTA #}
			{% if planCode is defined %}
				<section class="am-section">
					{% if planCode == 'FREE' %}
						{# Upgrade to STARTER #}
						{{ include('admin/partials/upgrade-cta.html.twig', {
							title: 'Débloquez plus de fonctionnalités',
							price: '9,90€/mois',
							features: [
								'Menus du jour ILLIMITÉS',
								'10 Menus spéciaux/an',
								'Thèmes et styles avancés',
								'Export PDF haute qualité'
							],
							buttonText: 'Découvrir Starter',
							buttonUrl: path('app_subscription_plans'),
							theme: 'starter'
						}) }}

					{% elseif planCode == 'STARTER' %}
						{# Upgrade to PREMIUM #}
						{{ include('admin/partials/upgrade-cta.html.twig', {
							title: 'Passez à Premium pour aller plus loin',
							price: '19,90€/mois',
							priceNote: '(+10€)',
							features: [
								'Création de CARTES complètes',
								'Catalogue de plats illimité',
								'Gestion multi-sections',
								'QR Code pour impression',
								'Statistiques avancées'
							],
							buttonText: 'Passer à Premium',
							buttonUrl: path('app_subscription_plans'),
							theme: 'premium'
						}) }}
					{% endif %}
				</section>
			{% endif %}

		{% else %}
			{# Fallback for other roles #}
			<div class="alert alert-warning">
				Vous n'avez pas les permissions nécessaires pour accéder à ce dashboard.
			</div>
		{% endif %}

	</div>

    {% if userRestaurants|length > 1 %}
	<div class="modal fade" id="restaurantSelectionModal" tabindex="-1" aria-labelledby="restaurantSelectionModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header bg-primary text-white">
					<h5 class="modal-title" id="restaurantSelectionModalLabel">
						<i class="fa fa-utensils me-2"></i>
						Sélectionnez un restaurant
					</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="text-muted mb-3">Pour quel restaurant souhaitez-vous créer ce menu ?</p>
					<div class="list-group">
						{% for restaurant in userRestaurants %}
						<button type="button"
								class="list-group-item list-group-item-action restaurant-choice"
								data-restaurant-id="{{ restaurant.id }}"
								data-restaurant-name="{{ restaurant.name }}">
							<div class="d-flex w-100 justify-content-between align-items-center">
								<div>
									<h6 class="mb-1">{{ restaurant.name }}</h6>
									<small class="text-muted">
										<i class="fa fa-location-dot me-1"></i>
										{{ restaurant.city }} ({{ restaurant.zipCode }})
									</small>
								</div>
								<i class="fa fa-chevron-right text-muted"></i>
							</div>
						</button>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>
	{% endif %}

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		/**
		 * Copy text to clipboard from input element
		 */
		function copyToClipboard(elementId) {
			const input = document.getElementById(elementId);
			if (!input) return;

			input.select();
			input.setSelectionRange(0, 99999); // For mobile devices

			try {
				navigator.clipboard.writeText(input.value).then(() => {
					// Visual feedback
					const btn = event.target.closest('button');
					if (btn) {
						const originalHTML = btn.innerHTML;
						btn.innerHTML = '<i class="fa fa-check"></i>';
						btn.classList.add('btn-success');
						btn.classList.remove('btn-outline-primary');

						setTimeout(() => {
							btn.innerHTML = originalHTML;
							btn.classList.remove('btn-success');
							btn.classList.add('btn-outline-primary');
						}, 1500);
					}
				}).catch(err => {
					// Fallback for older browsers
					document.execCommand('copy');
					console.log('Lien copié (fallback)');
				});
			} catch (err) {
				console.error('Erreur lors de la copie:', err);
			}
		}

		/**
		 * Copy the first published menu URL
		 */
		function copyFirstPublicUrl() {
			const publishedUrlInput = document.getElementById('published-url');
			if (publishedUrlInput) {
				copyToClipboard('published-url');
			}
		}

		/**
		 * Initialize theme from user preference or system preference
		 */
		function initTheme() {
			const savedTheme = localStorage.getItem('am-theme');
			const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			const theme = savedTheme || systemTheme;

			document.documentElement.setAttribute('data-bs-theme', theme);
		}

		/**
		 * Update theme toggle button icon
		 */
		function updateThemeIcon() {
			const currentTheme = document.documentElement.getAttribute('data-bs-theme');
			const icon = document.getElementById('theme-icon');

			if (icon) {
				icon.className = currentTheme === 'dark' ? 'fa fa-sun' : 'fa fa-moon';
			}
		}

		/**
		 * Toggle between light and dark theme
		 */
		function toggleTheme() {
			const currentTheme = document.documentElement.getAttribute('data-bs-theme');
			const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

			document.documentElement.setAttribute('data-bs-theme', newTheme);
			localStorage.setItem('am-theme', newTheme);
			updateThemeIcon();
		}

		// Initialize theme on page load
		document.addEventListener('DOMContentLoaded', () => {
			initTheme();
			updateThemeIcon();

			// Listen for system theme changes
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
				if (!localStorage.getItem('am-theme')) {
					document.documentElement.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light');
					updateThemeIcon();
				}
			});
		});

		// Restaurant modal is handled by restaurant-modal.js
	</script>
{% endblock %}
