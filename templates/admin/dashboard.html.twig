{% extends '@EasyAdmin/page/content.html.twig' %}
{# {% block content_title %}
    <span class="am-header-title">
        <i class="fa fa-fire"></i>
        Mode StreetFood actif
    </span>
{% endblock %} #}

{% block configured_head_contents %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/admin/admin-theme.css') }}">
	<script src="{{ asset('js/restaurant-modal.js') }}" defer></script>
{% endblock %}

{% block main %}
	{% set publishedMenu = publishedMenu ?? null %}
	{% if publishedMenu %}
		{% set publishedUrl = url('app_show_menu', {
            restaurant: publishedMenu.owner.slug,
            slug: publishedMenu.slug
        }) %}
	{% endif %}

	<div class="container-fluid am-dashboard py-4">

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            {{include('partials/admin/_admin_dashboard.html.twig')}}
        {% elseif is_granted('ROLE_ADMIN') %}
		<header class="am-hero card border-0 shadow-sm mb-4">
			<div class="card-body">
				<div class="d-flex justify-content-end mb-2">
					<button class="btn btn-sm btn-outline-secondary" id="theme-toggle" onclick="toggleTheme()" title="Changer de thème">
						<i class="fa fa-circle-half-stroke" id="theme-icon"></i>
						<span class="d-none d-md-inline ms-1">Thème</span>
					</button>
				</div>
				<div class="row align-items-center g-4">
					<div class="col-xl-7">
						<div class="d-flex align-items-center gap-2 text-uppercase small fw-semibold text-muted mb-2">
							<i class="fa fa-truck-fast text-primary"></i>
							<span>Ligne de feu pour les chefs</span>
						</div>
						<h1 class="mb-2">Ardoise & Menus en mode street</h1>
						<p class="text-muted mb-3">
							Tableaux prêts à partager, liens publics immédiats et actions rapides pour garder votre carte à jour sans effort.
						</p>
						<div class="d-flex flex-wrap gap-2 mb-3">
							<span class="am-chip">
								<i class="fa fa-user me-2 text-primary"></i>
								{{ app.user.firstname }}
							</span>
							<span class="am-chip">
								<i class="fa fa-link me-2 text-primary"></i>
								/m/{{ app.user.slug }}/[slug-menu]
							</span>
							<span class="am-chip">
								<i class="fa fa-bullhorn me-2 text-primary"></i>
								{{ menusPublies }} publié{{ menusPublies > 1 ? 's' : '' }}
							</span>
						</div>
						<div class="d-flex flex-wrap gap-2">
							<a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\DailyMenuCrudController').setAction('new') }}">
								<i class="fa fa-plus me-2"></i>
								Menu du jour
							</a>
							<a class="btn btn-outline-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\SpecialMenuCrudController').setAction('new') }}">
								<i class="fa fa-star me-2"></i>
								Menu spécial
							</a>
							<a class="btn btn-link text-decoration-none" href="#menus-list">
								<i class="fa fa-list me-2"></i>
								Voir mes menus
							</a>
						</div>
					</div>
					<div class="col-xl-5">
						<div class="am-card am-status-panel h-100">
							<div class="d-flex justify-content-between align-items-center mb-2">
								<div class="text-muted fw-semibold">Lien public</div>
								<span class="am-status-chip {{ publishedMenu ? 'is-online' : 'is-offline' }}">
									<i class="fa {{ publishedMenu ? 'fa-check' : 'fa-eye-slash' }} me-1"></i>
									{{ publishedMenu ? 'Publié' : 'En attente' }}
								</span>
							</div>
							{% if publishedMenu %}
								<div class="mb-3">
									<div class="small text-muted mb-2">
										Menu : <span class="fw-semibold">{{ publishedMenu.titre }}</span>
									</div>
									<div class="input-group input-group-sm">
										<input type="text" class="form-control" id="published-url" value="{{ publishedUrl }}" readonly>
										<button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('published-url')" title="Copier le lien">
											<i class="fa fa-copy"></i>
										</button>
										<a class="btn btn-outline-success" href="{{ publishedUrl }}" target="_blank" title="Voir le menu">
											<i class="fa fa-external-link-alt"></i>
										</a>
									</div>
								</div>
								<div class="d-flex flex-column gap-1 small text-muted">
									<span><i class="fa fa-qrcode me-2 text-primary"></i>Imprimez ou placez ce lien dans un QR code pour vos tables.</span>
									<span><i class="fa fa-bolt me-2 text-warning"></i>Republiez après chaque service pour rester en tête des feeds.</span>
								</div>
							{% else %}
								<div class="p-3 bg-light rounded-3 text-center">
									<p class="mb-1 fw-semibold">Aucun menu publié</p>
									<p class="mb-0 text-muted small">Publiez un menu pour activer un lien public partageable.</p>
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</header>

		{# Subscription Info & Quota Widgets #}
		{% if planCode is defined %}
		<section class="am-section mb-4">
			<div class="subscription-widget mb-3 p-3 card border-0 shadow-sm">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<h5 class="mb-1">
							<i class="fa fa-crown me-2 text-warning"></i>
							Plan actuel: <strong>{{ planName }}</strong>
						</h5>
						{% if planCode == 'FREE' %}
							<p class="text-muted mb-0 small">Passez à Starter ou Premium pour plus de fonctionnalités</p>
						{% endif %}
					</div>
					{% if planCode != 'PREMIUM' %}
						<a href="{{ path('app_subscription_plans') }}" class="btn btn-warning btn-sm">
							<i class="fa fa-arrow-up me-2"></i>
							Voir les offres
						</a>
					{% endif %}
				</div>
			</div>

			<div class="row g-3">
				<div class="col-md-6">
					<div class="am-card h-100">
						<div class="card-header bg-primary text-white border-0">
							<h6 class="mb-0">
								<i class="fa fa-sun me-2"></i>
								Menus du Jour
							</h6>
						</div>
						<div class="card-body">
							{% set dailyQuota = quotaInfo.daily_menus %}

							{% if dailyQuota.limit == -1 %}
								<p class="text-success mb-1 fw-bold">
									<i class="fa fa-infinity me-2"></i>Illimité
								</p>
								<p class="text-muted small mb-0">{{ dailyQuota.used }} créés {{ dailyQuota.period }}</p>
							{% else %}
								<div class="progress mb-3" style="height: 25px;">
									{% set percentage = dailyQuota.limit > 0 ? ((dailyQuota.used / dailyQuota.limit * 100)|round) : 0 %}
									<div class="progress-bar
										{% if percentage >= 100 %}bg-danger
										{% elseif percentage >= 80 %}bg-warning
										{% else %}bg-success{% endif %}"
										style="width: {{ percentage }}%">
										{{ percentage }}%
									</div>
								</div>
								<p class="mb-2">
									<strong>{{ dailyQuota.used }}</strong> / {{ dailyQuota.limit }}
									menus utilisés {{ dailyQuota.period }}
								</p>

								{% if dailyQuota.used >= dailyQuota.limit %}
									<div class="alert alert-danger mb-0 py-2">
										<i class="fa fa-exclamation-triangle me-2"></i>
										<strong>Quota atteint!</strong>
										<a href="{{ path('app_subscription_plans') }}" class="alert-link">Passer à Starter</a>
									</div>
								{% endif %}
							{% endif %}
						</div>
					</div>
				</div>

				<div class="col-md-6">
					<div class="am-card h-100">
						<div class="card-header bg-info text-white border-0">
							<h6 class="mb-0">
								<i class="fa fa-star me-2"></i>
								Menus Spéciaux
							</h6>
						</div>
						<div class="card-body">
							{% set specialQuota = quotaInfo.special_menus %}

							{% if not canCreateSpecial %}
								<div class="alert alert-warning mb-0">
									<i class="fa fa-lock me-2"></i>
									<strong>Fonctionnalité non disponible</strong>
									<br>
									<small>Disponible avec le plan Starter</small>
									<br>
									<a href="{{ path('app_subscription_plans') }}" class="btn btn-sm btn-warning mt-2">
										Découvrir les plans
									</a>
								</div>
							{% elseif specialQuota.limit == -1 %}
								<p class="text-success mb-1 fw-bold">
									<i class="fa fa-infinity me-2"></i>Illimité
								</p>
								<p class="text-muted small mb-0">{{ specialQuota.used }} créés {{ specialQuota.period }}</p>
							{% else %}
								<div class="progress mb-3" style="height: 25px;">
									{% set percentage = specialQuota.limit > 0 ? ((specialQuota.used / specialQuota.limit * 100)|round) : 0 %}
									<div class="progress-bar
										{% if percentage >= 100 %}bg-danger
										{% elseif percentage >= 80 %}bg-warning
										{% else %}bg-success{% endif %}"
										style="width: {{ percentage }}%">
										{{ percentage }}%
									</div>
								</div>
								<p class="mb-2">
									<strong>{{ specialQuota.used }}</strong> / {{ specialQuota.limit }}
									menus utilisés {{ specialQuota.period }}
								</p>

								{% if specialQuota.used >= specialQuota.limit %}
									<div class="alert alert-danger mb-0 py-2">
										<i class="fa fa-exclamation-triangle me-2"></i>
										<strong>Quota atteint!</strong>
										<a href="{{ path('app_subscription_plans') }}" class="alert-link">Passer à Premium</a>
									</div>
								{% endif %}
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</section>
		{% endif %}

		<section class="am-section mb-4">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<div class="am-section-title">
					<i class="fa fa-gauge-high me-2 text-primary"></i>
					Vue rapide
				</div>
			</div>
			<div class="row g-3">
				<div class="col-12 col-md-4">
					<div class="am-card am-kpi h-100">
						<div class="d-flex align-items-center gap-3">
							<div class="am-kpi-icon bg-primary-subtle text-primary">
								<i class="fa fa-fire"></i>
							</div>
							<div >
								<div class="am-kpi-label">Total menus</div>
								<div class="am-kpi-value">{{ totalMenus }}</div>
								<small class="text-muted">Ardoises prêtes</small>
							</div>
						</div>
					</div>
				</div>
				<div class="col-12 col-md-4">
					<div class="am-card am-kpi h-100">
						<div class="d-flex align-items-center gap-3">
							<div class="am-kpi-icon bg-success-subtle text-success">
								<i class="fa fa-check"></i>
							</div>
							<div>
								<div class="am-kpi-label">Publiés</div>
								<div class="am-kpi-value">{{ menusPublies }}</div>
								<small class="text-muted">Visible par vos clients</small>
							</div>
						</div>
					</div>
				</div>
				<div class="col-12 col-md-4">
					<div class="am-card am-kpi h-100">
						<div class="d-flex align-items-center gap-3">
							<div class="am-kpi-icon bg-warning-subtle text-warning">
								<i class="fa fa-hourglass-half"></i>
							</div>
							<div>
								<div class="am-kpi-label">Brouillons</div>
								<div class="am-kpi-value">{{ totalMenus - menusPublies }}</div>
								<small class="text-muted">En cuisine</small>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="am-section mb-4">
			<div class="row g-3">
				<div class="col-lg-4">
					<div class="am-card h-100">
						<div class="d-flex align-items-start justify-content-between mb-2">
							<h4 class="am-card-title mb-0">
								<i class="fa fa-wand-magic-sparkles me-2 text-primary"></i>
								Raccourcis de service
							</h4>
						</div>
						<p class="text-muted small">
							Créez, dupliquez ou ajustez vos ardoises en quelques secondes.
						</p>
						<div class="d-flex flex-wrap gap-2">
							<a class="btn btn-outline-primary btn-sm" href="{{ ea_url().setController('App\\Controller\\Admin\\DailyMenuCrudController').setAction('new') }}">
								<i class="fa fa-plus me-2"></i>
								Nouveau menu du jour
							</a>
							<a class="btn btn-outline-primary btn-sm" href="{{ ea_url().setController('App\\Controller\\Admin\\SpecialMenuCrudController').setAction('new') }}">
								<i class="fa fa-star me-2"></i>
								Nouveau spécial
							</a>
						</div>
					</div>
				</div>

				<div class="col-lg-4">
					<div class="am-card h-100">
						<h4 class="am-card-title mb-2">
							<i class="fa fa-lightbulb me-2 text-warning"></i>
							Plan de tir
						</h4>
						<ul class="am-list mb-0">
							<li>Nommer le menu (date ou événement) de façon claire.</li>
							<li>Renseigner prix et items, puis cocher "Publié".</li>
							<li>Copier le lien public et coller en story ou QR code.</li>
							<li>Mettre à jour chaque jour pour booster la fidélité.</li>
						</ul>
					</div>
				</div>

				<div class="col-lg-4">
					<div class="am-card h-100">
						<h4 class="am-card-title mb-2">
							<i class="fa fa-bullhorn me-2 text-success"></i>
							Partage express
						</h4>
						<p class="text-muted small">
							Diffusez votre carte sur vos canaux en un clic. Copiez le lien et balancez-le dans vos stories.
						</p>
						<div class="d-flex flex-wrap gap-2">
							<button class="btn btn-outline-success btn-sm" type="button" onclick="copyFirstPublicUrl()" {% if not publishedMenu %} disabled {% endif %}>
								<i class="fa fa-copy me-2"></i>
								Copier le lien actif
							</button>
							{% if publishedMenu %}
								<a class="btn btn-success btn-sm" href="{{ publishedUrl }}" target="_blank">
									<i class="fa fa-external-link-alt me-2"></i>
									Voir le rendu client
								</a>
							{% endif %}
						</div>
						<small class="text-muted d-block mt-2">
							Astuce : ajoutez le lien dans la bio Instagram ou Google Business.
						</small>
					</div>
				</div>
			</div>
		</section>

		<div class="am-section" id="menus-list">
			<div class="am-card">
				<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
					<div>
						<div class="am-section-title mb-1">
							<i class="fa fa-clipboard-list me-2 text-primary"></i>
							Mes ardoises
						</div>
						<div class="text-muted small">Lien public uniquement si "Publié" est actif.</div>
					</div>
					<div class="d-flex gap-2">
						<a class="btn btn-primary btn-sm" href="{{ ea_url().setController('App\\Controller\\Admin\\DailyMenuCrudController').setAction('new') }}">
							<i class="fa fa-plus me-2"></i>Menu du jour
						</a>
						<a class="btn btn-outline-primary btn-sm" href="{{ ea_url().setController('App\\Controller\\Admin\\SpecialMenuCrudController').setAction('new') }}">
							<i class="fa fa-star me-2"></i>Menu spécial
						</a>
					</div>
				</div>
				{% if menus is defined and menus|length > 0 %}
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th class="text-uppercase small text-muted">Type</th>
									<th class="text-uppercase small text-muted">Titre</th>
									{% if is_granted('ROLE_SUPER_ADMIN') %}
										<th class="text-uppercase small text-muted">Restaurant</th>
									{% endif %}
									<th class="text-uppercase small text-muted">Statut</th>
									<th class="text-uppercase small text-muted">Lien</th>
								</tr>
							</thead>
							<tbody>
								{% for menu in menus %}
									{% set rowUrl = url('app_show_menu', {
                                        restaurant: menu.owner.slug,
                                        slug: menu.slug
                                    }) %}
									<tr>
										<td>
											{% if menu.type == 'DAILY' %}
												<span class="am-pill daily">
													<i class="fa fa-sun me-1"></i>
													Jour
												</span>
											{% else %}
												<span class="am-pill special">
													<i class="fa fa-star me-1"></i>
													Spécial
												</span>
											{% endif %}
										</td>
										<td class="fw-semibold">{{ menu.titre }}</td>
										{% if is_granted('ROLE_SUPER_ADMIN') %}
											<td><small class="text-muted">{{ menu.restaurant.name }}</small></td>
										{% endif %}
										<td>
											{% if menu.status %}
												<span class="am-pill success">
													<i class="fa fa-check me-1"></i>
													Publié
												</span>
											{% else %}
												<span class="am-pill draft">
													<i class="fa fa-moon me-1"></i>
													Brouillon
												</span>
											{% endif %}
										</td>
										<td>
											<div class="input-group input-group-sm">
												<input type="text" class="form-control" value="{{ rowUrl }}" id="url-{{ menu.id }}" readonly>
												<button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('url-{{ menu.id }}')" title="Copier le lien" {% if not menu.status %} disabled {% endif %}>
													<i class="fa fa-copy"></i>
												</button>
												<a href="{{ rowUrl }}" class="btn {{ menu.status ? 'btn-outline-success' : 'btn-outline-secondary disabled' }}" target="_blank" title="Voir le menu" {% if not menu.status %} aria-disabled="true" tabindex="-1" {% endif %}>
													<i class="fa fa-external-link-alt"></i>
												</a>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<p class="mb-0 text-muted">Aucun menu pour le moment. Lancez un menu du jour ou un special pour commencer.</p>
				{% endif %}
			</div>
		</div>
        {% endif %}
	</div>

	{# Modal de sélection de restaurant #}
	{% if userRestaurants|length > 1 %}
	<div class="modal fade" id="restaurantSelectionModal" tabindex="-1" aria-labelledby="restaurantSelectionModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header bg-primary text-white">
					<h5 class="modal-title" id="restaurantSelectionModalLabel">
						<i class="fa fa-utensils me-2"></i>
						Sélectionnez un restaurant
					</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="text-muted mb-3">Pour quel restaurant souhaitez-vous créer ce menu ?</p>
					<div class="list-group">
						{% for restaurant in userRestaurants %}
						<button type="button"
								class="list-group-item list-group-item-action restaurant-choice"
								data-restaurant-id="{{ restaurant.id }}"
								data-restaurant-name="{{ restaurant.name }}">
							<div class="d-flex w-100 justify-content-between align-items-center">
								<div>
									<h6 class="mb-1">{{ restaurant.name }}</h6>
									<small class="text-muted">
										<i class="fa fa-location-dot me-1"></i>
										{{ restaurant.city }} ({{ restaurant.zipCode }})
									</small>
								</div>
								<i class="fa fa-chevron-right text-muted"></i>
							</div>
						</button>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>
	{% endif %}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		/**
		 * Copy text to clipboard from input element
		 */
		function copyToClipboard(elementId) {
			const input = document.getElementById(elementId);
			if (!input) return;

			input.select();
			input.setSelectionRange(0, 99999); // For mobile devices

			try {
				navigator.clipboard.writeText(input.value).then(() => {
					// Visual feedback
					const btn = event.target.closest('button');
					if (btn) {
						const originalHTML = btn.innerHTML;
						btn.innerHTML = '<i class="fa fa-check"></i>';
						btn.classList.add('btn-success');
						btn.classList.remove('btn-outline-primary');

						setTimeout(() => {
							btn.innerHTML = originalHTML;
							btn.classList.remove('btn-success');
							btn.classList.add('btn-outline-primary');
						}, 1500);
					}
				}).catch(err => {
					// Fallback for older browsers
					document.execCommand('copy');
					console.log('Lien copié (fallback)');
				});
			} catch (err) {
				console.error('Erreur lors de la copie:', err);
			}
		}

		/**
		 * Copy the first published menu URL
		 */
		function copyFirstPublicUrl() {
			const publishedUrlInput = document.getElementById('published-url');
			if (publishedUrlInput) {
				copyToClipboard('published-url');
			}
		}

		/**
		 * Initialize theme from user preference or system preference
		 */
		function initTheme() {
			const savedTheme = localStorage.getItem('am-theme');
			const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			const theme = savedTheme || systemTheme;

			document.documentElement.setAttribute('data-bs-theme', theme);
		}

		/**
		 * Update theme toggle button icon
		 */
		function updateThemeIcon() {
			const currentTheme = document.documentElement.getAttribute('data-bs-theme');
			const icon = document.getElementById('theme-icon');

			if (icon) {
				icon.className = currentTheme === 'dark' ? 'fa fa-sun' : 'fa fa-moon';
			}
		}

		/**
		 * Toggle between light and dark theme
		 */
		function toggleTheme() {
			const currentTheme = document.documentElement.getAttribute('data-bs-theme');
			const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

			document.documentElement.setAttribute('data-bs-theme', newTheme);
			localStorage.setItem('am-theme', newTheme);
			updateThemeIcon();
		}

		// Initialize theme on page load
		document.addEventListener('DOMContentLoaded', () => {
			initTheme();
			updateThemeIcon();

			// Listen for system theme changes
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
				if (!localStorage.getItem('am-theme')) {
					document.documentElement.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light');
					updateThemeIcon();
				}
			});
		});

		// Restaurant modal is handled by restaurant-modal.js
	</script>
{% endblock %}
