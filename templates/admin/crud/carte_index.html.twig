{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var entities \EasyCorp\Bundle\EasyAdminBundle\Collection\EntityCollection #}
{# @var paginator \EasyCorp\Bundle\EasyAdminBundle\Orm\EntityPaginator #}
{% set ea = ea() %}
{% extends ea.templatePath('layout') %}
{% trans_default_domain ea.i18n.translationDomain %}

{% block body_id entities|length > 0 ? 'ea-index-' ~ entities|first.name : '' %}
{% block body_class 'ea-index' ~ (entities|length > 0 ? ' ea-index-' ~ entities|first.name : '') %}

{% block content_title %}
    {%- set custom_page_title = ea.crud.customPageTitle('index', null, ea.i18n.translationParameters, ea.i18n.translationDomain) -%}
    {{- custom_page_title is null
        ? ea.crud.defaultPageTitle('index', null, ea.i18n.translationParameters)|trans|raw
        : custom_page_title|trans|raw -}}
{% endblock %}

{% block page_actions %}
    {% block global_actions %}
        {% if global_actions is defined and global_actions|length > 0 %}
            <div class="global-actions">
                {% for action in global_actions %}
                    {{ include(action.templatePath, {action: action}, with_context: false) }}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock global_actions %}
{% endblock page_actions %}

{% block main %}
    {# Include delete confirmation modal #}
    {% include 'admin/partials/delete-confirmation-modal.html.twig' %}

    <div class="recent-contents" id="cartes-crud-list">
        <div class="recent-contents__table-wrapper">
            {% if entities|length > 0 %}
                <table class="recent-contents__table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                <th>Restaurant</th>
                            {% endif %}
                            <th>Validité</th>
                            <th>Statut</th>
                            <th>Lien</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entity in entities %}
                            {% set carte = entity.instance %}
                            {% set rowUrl = url('app_show_carte', {
                                restaurant: carte.restaurant.owner.slug,
                                slug: carte.slug
                            }) %}
                            <tr class="recent-contents__row" data-carte-id="{{ carte.id }}">
                                {# Header mobile cliquable - visible uniquement sur mobile #}
                                <td class="recent-contents__mobile-header" colspan="100">
                                    <button class="recent-contents__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#carte-details-{{ carte.id }}" aria-expanded="false">
                                        <span class="recent-contents__toggle-title">{{ carte.name }}</span>
                                        <i class="fa fa-chevron-down recent-contents__toggle-icon"></i>
                                    </button>
                                </td>

                                {# Colonnes normales pour desktop #}
                                <td data-label="Nom" class="recent-contents__name recent-contents__desktop-cell">{{ carte.name }}</td>
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <td data-label="Restaurant" class="recent-contents__restaurant recent-contents__desktop-cell">{{ carte.restaurant.name }}</td>
                                {% endif %}
                                <td data-label="Validité" class="recent-contents__desktop-cell">
                                    <div class="validity-info">
                                        <small>{{ carte.validFrom|date('d/m/Y') }}</small>
                                        {% if carte.validTo %}
                                            <small> → {{ carte.validTo|date('d/m/Y') }}</small>
                                        {% else %}
                                            <small class="text-muted"> (illimitée)</small>
                                        {% endif %}
                                    </div>
                                </td>
                                <td data-label="Statut" class="recent-contents__desktop-cell">
                                    {% if carte.isPublished %}
                                        <span class="status-badge status-badge--published">
                                            <i class="fa fa-check me-1"></i>
                                            Publiée
                                        </span>
                                    {% else %}
                                        <span class="status-badge status-badge--draft">
                                            <i class="fa fa-moon me-1"></i>
                                            Brouillon
                                        </span>
                                    {% endif %}
                                </td>
                                <td data-label="Lien public" class="recent-contents__desktop-cell">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" value="{{ rowUrl }}" id="url-{{ carte.id }}" readonly>
                                        <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('url-{{ carte.id }}')" title="Copier le lien" {% if not carte.isPublished %} disabled {% endif %}>
                                            <i class="fa fa-copy"></i>
                                        </button>
                                        <a href="{{ rowUrl }}" class="btn {{ carte.isPublished ? 'btn-outline-success' : 'btn-outline-secondary disabled' }}" target="_blank" title="Voir la carte" {% if not carte.isPublished %} aria-disabled="true" tabindex="-1" {% endif %}>
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                                <td data-label="Actions" class="recent-contents__desktop-cell">
                                    <div class="btn-group btn-group-sm">
                                        {% set editAction = entity.actions.get('editWizard') %}
                                        {% if editAction %}
                                            <a href="{{ editAction.linkUrl }}" class="btn btn-outline-primary" title="Modifier">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        {% endif %}
                                        {% set deleteAction = entity.actions.get('delete') %}
                                        {% if deleteAction %}
                                            <form method="POST" action="{{ deleteAction.linkUrl }}" style="display: inline;">
                                                <input type="hidden" name="token" value="{{ csrf_token('ea-delete') }}">
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        title="Supprimer"
                                                        data-delete-confirm
                                                        data-item-name="{{ carte.name }}">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>

                                {# Contenu dépliable pour mobile #}
                                <td class="recent-contents__mobile-details" colspan="100">
                                    <div class="collapse" id="carte-details-{{ carte.id }}">
                                        <div class="recent-contents__details-content">
                                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                                <div class="recent-contents__detail-item">
                                                    <span class="recent-contents__detail-label">Restaurant</span>
                                                    <span class="recent-contents__restaurant">{{ carte.restaurant.name }}</span>
                                                </div>
                                            {% endif %}

                                            <div class="recent-contents__detail-item">
                                                <span class="recent-contents__detail-label">Validité</span>
                                                <div class="validity-info">
                                                    <small>{{ carte.validFrom|date('d/m/Y') }}</small>
                                                    {% if carte.validTo %}
                                                        <small> → {{ carte.validTo|date('d/m/Y') }}</small>
                                                    {% else %}
                                                        <small class="text-muted"> (illimitée)</small>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            <div class="recent-contents__detail-item">
                                                <span class="recent-contents__detail-label">Statut</span>
                                                {% if carte.isPublished %}
                                                    <span class="status-badge status-badge--published">
                                                        <i class="fa fa-check me-1"></i>
                                                        Publiée
                                                    </span>
                                                {% else %}
                                                    <span class="status-badge status-badge--draft">
                                                        <i class="fa fa-moon me-1"></i>
                                                        Brouillon
                                                    </span>
                                                {% endif %}
                                            </div>

                                            <div class="recent-contents__detail-item">
                                                <span class="recent-contents__detail-label">Lien public</span>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control" value="{{ rowUrl }}" id="url-mobile-{{ carte.id }}" readonly>
                                                    <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('url-mobile-{{ carte.id }}')" title="Copier le lien" {% if not carte.isPublished %} disabled {% endif %}>
                                                        <i class="fa fa-copy"></i>
                                                    </button>
                                                    <a href="{{ rowUrl }}" class="btn {{ carte.isPublished ? 'btn-outline-success' : 'btn-outline-secondary disabled' }}" target="_blank" title="Voir la carte" {% if not carte.isPublished %} aria-disabled="true" tabindex="-1" {% endif %}>
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="recent-contents__detail-item">
                                                <span class="recent-contents__detail-label">Actions</span>
                                                <div class="btn-group btn-group-sm">
                                                    {% set editAction = entity.actions.get('editWizard') %}
                                                    {% if editAction %}
                                                        <a href="{{ editAction.linkUrl }}" class="btn btn-outline-primary" title="Modifier">
                                                            <i class="fa fa-edit"></i> Modifier
                                                        </a>
                                                    {% endif %}
                                                    {% set deleteAction = entity.actions.get('delete') %}
                                                    {% if deleteAction %}
                                                        <form method="POST" action="{{ deleteAction.linkUrl }}" style="display: inline;">
                                                            <input type="hidden" name="token" value="{{ csrf_token('ea-delete') }}">
                                                            <button type="button"
                                                                    class="btn btn-outline-danger"
                                                                    title="Supprimer"
                                                                    data-delete-confirm
                                                                    data-item-name="{{ carte.name }}">
                                                                <i class="fa fa-trash"></i> Supprimer
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="recent-contents__empty">
                    Aucune carte pour le moment.
                </div>
            {% endif %}
        </div>
    </div>

    {# Pagination #}
    {% if entities|length > 0 %}
        <div class="content-panel-footer without-padding without-border">
            {{ include(ea.templatePath('crud/paginator')) }}
        </div>
    {% endif %}
{% endblock main %}

{% block body_javascript %}
    {{ parent() }}
    <script>
    function copyToClipboard(elementId) {
        const input = document.getElementById(elementId);
        input.select();
        input.setSelectionRange(0, 99999); // For mobile devices

        navigator.clipboard.writeText(input.value).then(function() {
            // Visual feedback
            const button = input.nextElementSibling;
            const originalHTML = button.innerHTML;
            button.innerHTML = '<i class="fa fa-check"></i>';
            button.classList.add('btn-success');
            button.classList.remove('btn-outline-primary');

            setTimeout(function() {
                button.innerHTML = originalHTML;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-primary');
            }, 2000);
        }, function(err) {
            console.error('Could not copy text: ', err);
        });
    }
    </script>
{% endblock body_javascript %}
